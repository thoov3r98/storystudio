# ─── Database (Neon) ─────────────────────────────────────────────
# Pooled connection string used by the app and Trigger.dev tasks.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used only for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── OpenAI (writing, reviewing, illustrations) ──────────────────
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-5.5"          # writer (Standard/Premium quality)
OPENAI_TEXT_MODEL_FAST="gpt-5.4-mini" # reviewer / Draft quality
OPENAI_IMAGE_MODEL="gpt-image-2"
OPENAI_IMAGE_SIZE="1024x1536"         # portrait; composited into 1080x1920

# ─── ElevenLabs (narration) ──────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_DEFAULT_VOICE_ID=""        # optional; voices can also be set in Settings

# ─── Vercel Blob (images, audio, MP4s) ───────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── Trigger.dev (background jobs) ───────────────────────────────
TRIGGER_SECRET_KEY=""                 # tr_dev_... locally, tr_prod_... in production
TRIGGER_PROJECT_REF=""                # proj_...

# ─── Rendering ───────────────────────────────────────────────────
# vercel-sandbox: production. local: renders on the machine running `trigger dev`.
RENDER_PROVIDER="vercel-sandbox"
# Shared secret between Trigger.dev and the internal render routes (>= 32 chars).
# Generate with: openssl rand -hex 32
RENDER_API_SECRET=""
# Your production deployment URL, e.g. https://invisible-world-studio.vercel.app
STUDIO_APP_URL=""
# Vercel "Protection Bypass for Automation" secret, so Trigger.dev can reach the render routes
# through Deployment Protection. The routes still require RENDER_API_SECRET.
VERCEL_AUTOMATION_BYPASS_SECRET=""
RENDER_SANDBOX_VCPUS="4"
# Local rendering only: path to a Chromium/headless-shell binary if Remotion's own download fails.
REMOTION_BROWSER_EXECUTABLE=""

# ─── Topic research (optional) ───────────────────────────────────
# YouTube Data API v3 key. With it, "Import details" on a YouTube reference stores
# verified, dated view/like/comment counts. Without it only title and creator are read (oEmbed).
YOUTUBE_API_KEY=""
