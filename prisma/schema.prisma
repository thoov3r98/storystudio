// The Invisible World Studio — data model.
//
// Conventions:
// - Every generated artifact (script version, scene image, voiceover, render) is
//   an immutable row. "Current" pointers select which row is live, so history is
//   never overwritten.
// - Money is stored as Decimal(12, 6) USD.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum StoryStatus {
  CONCEPT
  IN_PRODUCTION
  READY
  PUBLISHED
  CONTINUING
  ARCHIVED
}

enum EpisodeStatus {
  DRAFT // concept/hooks only, no script yet
  SCRIPTED // script exists, not yet produced
  IN_PRODUCTION
  READY // MP4 rendered, awaiting approval
  APPROVED // locked: changes fork a new version
  PUBLISHED // manually published by the user
  FAILED
}

enum VersionStatus {
  DRAFT
  APPROVED // locked: edits fork a new version
  SUPERSEDED
}

enum AssetStatus {
  PENDING
  GENERATING
  SUCCEEDED
  FAILED
}

enum Quality {
  DRAFT
  STANDARD
  PREMIUM
}

enum ConceptStatus {
  CANDIDATE
  SELECTED
  REJECTED
  DUPLICATE
}

enum JobType {
  BATCH_IDEATION
  TOPIC_DISCOVERY
  EPISODE_PRODUCTION
  REGENERATE_SCRIPT
  REGENERATE_SCENE_NARRATION
  REGENERATE_IMAGE
  REGENERATE_VOICEOVER
  RENDER
}

enum JobStatus {
  QUEUED
  GENERATING_IDEAS
  EVALUATING_CONCEPTS
  WRITING_STORY
  GENERATING_SCENES
  GENERATING_ILLUSTRATIONS
  GENERATING_VOICEOVER
  SYNCHRONIZING_NARRATION
  RENDERING_VIDEO
  UPLOADING_MP4
  COMPLETED
  FAILED
  CANCELED
}

enum Provider {
  OPENAI_TEXT
  OPENAI_IMAGE
  ELEVENLABS
  VERCEL_SANDBOX
}

enum AudioAssetKind {
  MUSIC
  SFX
}

/// How far a reference's details can be trusted.
enum ReferenceVerification {
  NEEDS_SOURCE // no confirmed URL yet
  USER_ENTERED // details typed in by the producer, not checked
  SOURCE_CONFIRMED // title and creator fetched from the platform (oEmbed / API)
}

/// Where a metric observation came from. Only API observations count as verified.
enum MetricSource {
  MANUAL
  YOUTUBE_API
}

enum TopicStrategy {
  EVIDENCE_BACKED // a close comparable in the library has audience evidence
  ADJACENT // related to successful references, but a new product
  EXPLORATORY // little or no comparable evidence
}

enum EvidenceLevel {
  VERIFIED // a linked reference has API-observed metrics
  REPORTED // linked references have only producer-entered metrics
  NONE // no comparable with any metrics
}

enum TopicStatus {
  PROPOSED
  APPROVED
  REJECTED
  DUPLICATE
  USED
}

enum StorytellingPattern {
  TRANSFORMATION
  HIDDEN_PROBLEM
  FACTORY_REVEAL
}

/// How a channel's videos are made. Only process explainers ("How it's made") for now.
enum ChannelFormat {
  PROCESS_EXPLAINER
}

// ───────────────────────────── Channels ────────────────────────────

/// A TikTok channel. Everything is generated for a channel: its profile steers pitching, writing and checking.
model Channel {
  id                String        @id @default(cuid())
  name              String
  /// The producer's prompt the profile was generated from.
  brief             String
  format            ChannelFormat
  /// Generated from the brief, then editable: subjects, voice, story shape, things to avoid, Surprise me guidance.
  profile           Json
  voiceId           String?
  styleKey          String        @default("stick-figure-color")
  targetDurationSec Int           @default(75)
  /// Each story is planned across minParts..maxParts videos; the planner picks the count.
  minParts          Int           @default(3)
  maxParts          Int           @default(5)
  quality           Quality       @default(STANDARD)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  stories Story[]
  batches Batch[]
  topics  ManufacturingTopicCandidate[]
}

// ───────────────────────────── Stories ─────────────────────────────

model Story {
  id                String                       @id @default(cuid())
  title             String
  normalizedTitle   String
  premise           String
  logline           String?
  /// The pitch's sketch of the stages (`beatSketch`); a lead for the researcher, never a source.
  storySeed         Json?
  keywords          String[]
  status            StoryStatus                  @default(CONCEPT)
  styleKey          String                       @default("stick-figure")
  voiceId           String?
  targetDurationSec Int                          @default(75)
  /// How many videos one story is planned across. Writing Part 1 plans and writes every part.
  plannedParts      Int                          @default(1)
  quality           Quality                      @default(STANDARD)
  thumbnailUrl      String?
  channelId         String?
  channel           Channel?                     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// Process explainers: the web research every part is written from (see src/lib/process).
  research          Json?
  /// Topic discovery snapshot from the chosen pitch (score, evidence, angle). See src/lib/topics.
  discovery         Json?
  topicCandidateId  String?
  topicCandidate    ManufacturingTopicCandidate? @relation(fields: [topicCandidateId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  lastActivityAt    DateTime                     @default(now())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  conceptId String?  @unique
  concept   Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  episodes     Episode[]
  jobs         Job[]
  costs        CostEntry[]
  storytelling ManufacturingStorytellingDecision?
  hooks        ManufacturingHookCandidate[]

  @@index([status])
  @@index([normalizedTitle])
  @@index([lastActivityAt])
  @@index([channelId])
}

// ───────────────────────────── Episodes ─────────────────────────────

model Episode {
  id                String          @id @default(cuid())
  storyId           String
  story             Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  partNumber        Int
  title             String
  status            EpisodeStatus   @default(DRAFT)
  currentVersionId  String?         @unique
  currentVersion    EpisodeVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  publishedAt       DateTime?
  publishedUrl      String?
  publishedPlatform String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  versions EpisodeVersion[]    @relation("EpisodeVersions")
  metrics  PerformanceMetric[]
  jobs     Job[]
  costs    CostEntry[]

  @@unique([storyId, partNumber])
}

/// An immutable-once-approved script version with its scenes and generated media.
model EpisodeVersion {
  id                   String        @id @default(cuid())
  episodeId            String
  episode              Episode       @relation("EpisodeVersions", fields: [episodeId], references: [id], onDelete: Cascade)
  currentOf            Episode?      @relation("CurrentVersion")
  version              Int
  status               VersionStatus @default(DRAFT)
  parentVersionId      String?
  /// Why this version exists: "initial", "regenerate-script", "regenerate-hook", "edit-scene", "fork-locked".
  reason               String
  /// EpisodeSpecSchema payload as written (excluding scenes, which are rows).
  spec                 Json
  narration            String
  wordCount            Int
  estimatedDurationSec Float
  summary              String
  /// Script gate verdict from the quality checks: passed, needs-attention or blocked. Null on versions written before them.
  qualityStatus        String?
  /// The producer's 1–5 rating of the story.
  humanRating          Int?
  /// Global style + per-story visual notes used to build image prompts.
  styleKey             String
  voiceoverId          String?
  voiceover            Voiceover?    @relation("CurrentVoiceover", fields: [voiceoverId], references: [id], onDelete: SetNull)
  /// Scene timing derived from the current voiceover alignment; null when stale.
  timing               Json?
  createdAt            DateTime      @default(now())

  scenes     Scene[]
  voiceovers Voiceover[] @relation("VersionVoiceovers")
  renders    Render[]

  @@unique([episodeId, version])
}

model Scene {
  id                  String         @id @default(cuid())
  episodeVersionId    String
  episodeVersion      EpisodeVersion @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  sceneNumber         Int
  narration           String
  imagePrompt         String
  composition         String
  /// What must stay true in this shot (where the hero is, time of day, what changed).
  continuity          String         @default("")
  characters          String[]
  objects             String[]
  intendedDurationSec Float
  motionPreset        String
  currentImageId      String?
  currentImage        SceneImage?    @relation("CurrentImage", fields: [currentImageId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())

  images SceneImage[] @relation("SceneImages")

  @@unique([episodeVersionId, sceneNumber])
}

/// Image history for a scene. When a version is forked, unchanged scenes point at the
/// same image row through `currentImageId`, so `sceneId` is the scene that first produced it.
model SceneImage {
  id            String      @id @default(cuid())
  sceneId       String
  scene         Scene       @relation("SceneImages", fields: [sceneId], references: [id], onDelete: Cascade)
  currentOf     Scene[]     @relation("CurrentImage")
  version       Int
  status        AssetStatus @default(PENDING)
  url           String?
  blobPath      String?
  prompt        String
  model         String
  quality       String
  usedReference Boolean     @default(false)
  review        Json?
  error         String?
  costUsd       Decimal     @default(0) @db.Decimal(12, 6)
  createdAt     DateTime    @default(now())

  @@index([sceneId])
}

model Voiceover {
  id               String           @id @default(cuid())
  episodeVersionId String
  episodeVersion   EpisodeVersion   @relation("VersionVoiceovers", fields: [episodeVersionId], references: [id], onDelete: Cascade)
  currentOf        EpisodeVersion[] @relation("CurrentVoiceover")
  version          Int
  status           AssetStatus      @default(PENDING)
  voiceId          String
  modelId          String
  settings         Json
  text             String
  url              String?
  blobPath         String?
  durationMs       Int?
  /// Raw character-level alignment from ElevenLabs.
  alignment        Json?
  /// Word timings derived from alignment: [{ text, startMs, endMs }].
  words            Json?
  characterCount   Int              @default(0)
  error            String?
  costUsd          Decimal          @default(0) @db.Decimal(12, 6)
  createdAt        DateTime         @default(now())
}

model Render {
  id               String         @id @default(cuid())
  episodeVersionId String
  episodeVersion   EpisodeVersion @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  version          Int
  status           AssetStatus    @default(PENDING)
  /// Snapshot of what was rendered: voiceover id + scene image ids.
  inputs           Json
  inputProps       Json
  url              String?
  sizeBytes        Int?
  durationSec      Float?
  sandboxId        String?
  commandId        String?
  progress         Float          @default(0)
  error            String?
  costUsd          Decimal        @default(0) @db.Decimal(12, 6)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([episodeVersionId])
}

model PerformanceMetric {
  id              String   @id @default(cuid())
  episodeId       String
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  platform        String
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  followersGained Int?
  avgWatchTimeSec Float?
  /// % of viewers still watching after the first few seconds.
  earlyRetention  Float?
  completionRate  Float?
  /// Rewatches as a % of views.
  rewatchRate     Float?
  notes           String?
  recordedAt      DateTime @default(now())
}

// ───────────────────────────── Batches & concepts ─────────────────────────────

model Batch {
  id                String   @id @default(cuid())
  customDirection   String?
  requestedCount    Int
  targetDurationSec Int
  styleKey          String
  voiceId           String
  quality           Quality
  maxBudgetUsd      Decimal  @db.Decimal(12, 6)
  estimatedCostUsd  Decimal  @default(0) @db.Decimal(12, 6)
  channelId         String?
  channel           Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  concepts Concept[]
  jobs     Job[]
  topics   ManufacturingTopicCandidate[]
}

model Concept {
  id               String        @id @default(cuid())
  batchId          String
  batch            Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title            String
  normalizedTitle  String
  premise          String
  logline          String
  keywords         String[]
  seriesPotential  String
  storySeed        Json?
  scores           Json?
  rank             Int?
  status           ConceptStatus @default(CANDIDATE)
  duplicateOfTitle String?
  similarity       Float?
  /// Topic discovery snapshot when the pitch came from evidence-based discovery.
  discovery        Json?
  createdAt        DateTime      @default(now())

  story Story?
  topic ManufacturingTopicCandidate?

  @@index([batchId])
}

// ───────────────────────────── Jobs & costs ─────────────────────────────

model Job {
  id           String    @id @default(cuid())
  type         JobType
  status       JobStatus @default(QUEUED)
  stage        String?
  progress     Float     @default(0)
  input        Json
  output       Json?
  error        Json?
  triggerRunId String?
  attempts     Int       @default(0)
  batchId      String?
  batch        Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  storyId      String?
  story        Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  episodeId    String?
  episode      Episode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  costs  CostEntry[]
  topics ManufacturingTopicCandidate[]

  @@index([status])
  @@index([createdAt])
}

model CostEntry {
  id        String   @id @default(cuid())
  provider  Provider
  model     String
  operation String
  /// Provider usage units (tokens, characters, seconds, images).
  usage     Json
  costUsd   Decimal  @db.Decimal(12, 6)
  /// True when cost was computed from configured pricing rather than reported by the provider.
  estimated Boolean  @default(true)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  storyId   String?
  story     Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  batchId   String?
  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([storyId])
  @@index([createdAt])
}

// ───────────────────────────── Settings & assets ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Bundled/licensed audio. Only owned, public-domain, or properly licensed assets belong here.
model AudioAsset {
  id          String         @id @default(cuid())
  name        String
  kind        AudioAssetKind
  url         String
  license     String
  source      String
  attribution String?
  createdAt   DateTime       @default(now())
}

// ───────────────────────────── Topic discovery ─────────────────────────────
// See src/lib/topics. References are evidence of audience interest; their
// metrics are timestamped observations, never timeless values.

/// A successful manufacturing video by someone else, kept as evidence of what audiences watch.
model ManufacturingContentReference {
  id                 String                @id @default(cuid())
  /// "youtube", "tiktok", "instagram", "other".
  platform           String
  creator            String
  /// Null while the source hasn't been found (verification NEEDS_SOURCE).
  url                String?               @unique
  title              String
  product            String
  normalizedProduct  String
  category           String
  publishedAt        DateTime?
  durationSec        Int?
  /// The step that makes the video worth watching, e.g. "a ribbon of ice cream cut and sandwiched".
  notableStep        String                @default("")
  curiosityMechanism String                @default("")
  /// The opening as actually observed; empty when not watched.
  observedHook       String                @default("")
  /// e.g. "molding", "forging", "recycling", "assembly line".
  transformationType String                @default("")
  verification       ReferenceVerification @default(USER_ENTERED)
  notes              String                @default("")
  /// What we may do with the video: usually "reference only, not reusable".
  usageRights        String                @default("Reference only; not licensed for reuse")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  metrics  ReferenceMetricObservation[]
  evidence TopicEvidence[]

  @@index([platform])
  @@index([category])
  @@index([normalizedProduct])
}

/// Audience numbers for a reference as seen at one moment. Missing numbers stay null.
model ReferenceMetricObservation {
  id          String                        @id @default(cuid())
  referenceId String
  reference   ManufacturingContentReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  observedAt  DateTime
  source      MetricSource                  @default(MANUAL)
  note        String                        @default("")
  createdAt   DateTime                      @default(now())

  @@index([referenceId, observedAt])
}

/// A product proposed by topic discovery, with its explainable score.
model ManufacturingTopicCandidate {
  id                  String        @id @default(cuid())
  channelId           String
  channel             Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// The Surprise me batch it was proposed for, if any.
  batchId             String?
  batch               Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  jobId               String?
  job                 Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// The pitch it became when shown on Make Videos.
  conceptId           String?       @unique
  concept             Concept?      @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  product             String
  normalizedProduct   String
  category            String
  title               String
  episodeConcept      String
  premise             String
  /// Stages sketch: a lead for the researcher, never a source.
  arc                 String
  strategy            TopicStrategy
  evidenceLevel       EvidenceLevel
  whyViewers          String
  featuredStage       String
  curiosityAngle      String
  visualPayoff        String
  researchFeasibility String
  visualFeasibility   String
  /// The reviewer's 0–10 ratings and notes per qualitative dimension (null until evaluated).
  ratings             Json?
  /// 0–100, computed in code from the ratings and the evidence.
  score               Float?
  scoreBreakdown      Json?
  status              TopicStatus   @default(PROPOSED)
  duplicateOf         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  evidence TopicEvidence[]
  stories  Story[]

  @@index([channelId, createdAt])
  @@index([normalizedProduct])
  @@index([batchId])
  @@index([jobId])
}

/// Why a reference counts as comparable evidence for a topic.
model TopicEvidence {
  id          String                        @id @default(cuid())
  candidateId String
  candidate   ManufacturingTopicCandidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  referenceId String
  reference   ManufacturingContentReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  relation    String

  @@unique([candidateId, referenceId])
  @@index([referenceId])
}

/// How a researched product is told: the storytelling pattern, featured stage and selected hook.
model ManufacturingStorytellingDecision {
  id                 String                      @id @default(cuid())
  storyId            String                      @unique
  story              Story                       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  pattern            StorytellingPattern
  /// "recommended" by the model, or "producer" when overridden.
  patternSource      String                      @default("recommended")
  reason             String
  curiosityMechanism String
  featuredStageId    String
  visualPayoff       String
  alternatives       StorytellingPattern[]
  /// Per research stage: visual subject, operation, material before/after, machinery, moment, claim ids.
  stageVisuals       Json
  selectedHookId     String?                     @unique
  selectedHook       ManufacturingHookCandidate? @relation("SelectedHook", fields: [selectedHookId], references: [id], onDelete: SetNull)
  /// `researchedAt` of the research this was made from; a mismatch means it is stale.
  researchedAt       String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
}

/// One candidate opening line, tied to research claims, with its independent review.
model ManufacturingHookCandidate {
  id               String                             @id @default(cuid())
  storyId          String
  story            Story                              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  selectedBy       ManufacturingStorytellingDecision? @relation("SelectedHook")
  pattern          StorytellingPattern
  line             String
  strategy         String
  /// Research claim ids ("T2.1" = stage T2, step 1).
  claimIds         String[]
  featuredStageId  String
  firstFrameVisual String
  whyItWorks       String
  uncertainty      String                             @default("")
  /// Visual metadata for the future visual engine: subject, operation, before/after, machinery.
  visual           Json
  /// Deterministic support problems (unknown claim ids, numbers not in the cited claims...).
  flags            String[]
  /// Reviewer's 1–5 scores per criterion, verdict and note (null if not reviewed).
  review           Json?
  /// Editorial heuristic, not a performance prediction.
  total            Float?
  rank             Int?
  createdAt        DateTime                           @default(now())

  @@index([storyId, pattern])
}
