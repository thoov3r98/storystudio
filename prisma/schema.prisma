// The Invisible World Studio — data model.
//
// Conventions:
// - Every generated artifact (script version, scene image, voiceover, render) is
//   an immutable row. "Current" pointers select which row is live, so history is
//   never overwritten.
// - Story continuity lives in StoryBible versions. Only bibles created from an
//   approved episode (or edited by hand) are canonical.
// - Money is stored as Decimal(12, 6) USD.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum StoryStatus {
  CONCEPT
  IN_PRODUCTION
  READY
  PUBLISHED
  CONTINUING
  ARCHIVED
}

enum FactMode {
  FACTUAL
  HYPOTHETICAL
  FICTIONAL
  MIXED
}

enum EpisodeStatus {
  DRAFT // concept/hooks only, no script yet
  SCRIPTED // script exists, not yet produced
  IN_PRODUCTION
  READY // MP4 rendered, awaiting approval
  APPROVED // continuity applied to story bible
  PUBLISHED // manually published by the user
  FAILED
}

enum VersionStatus {
  DRAFT
  APPROVED // locked: edits fork a new version
  SUPERSEDED
}

enum FactCheckStatus {
  PENDING
  PASSED // no unsupported claims presented as fact
  NEEDS_REVIEW // claims flagged for manual verification
  MANUALLY_APPROVED
}

enum ClaimClassification {
  ESTABLISHED_FACT
  PLAUSIBLE_EXAMPLE
  FICTIONAL
  NEEDS_VERIFICATION
}

enum ClaimStatus {
  UNVERIFIED
  SUPPORTED // model-attested as widely documented; still not independently verified
  FLAGGED
  REVISED
  MANUALLY_VERIFIED
  REJECTED
}

enum HookType {
  RELATABLE
  SURPRISING_FACT
  IMMEDIATE_DANGER
  QUESTION
  OTHER
}

enum AssetStatus {
  PENDING
  GENERATING
  SUCCEEDED
  FAILED
}

enum BatchMode {
  CONCEPT
  FULL_PRODUCTION
}

enum Quality {
  DRAFT
  STANDARD
  PREMIUM
}

enum ConceptStatus {
  CANDIDATE
  SELECTED
  REJECTED
  DUPLICATE
}

enum JobType {
  BATCH_IDEATION
  EPISODE_PRODUCTION
  CONTINUATION
  REGENERATE_HOOKS
  REGENERATE_SCRIPT
  REGENERATE_SCENE_NARRATION
  REGENERATE_IMAGE
  REGENERATE_VOICEOVER
  RENDER
}

enum JobStatus {
  QUEUED
  GENERATING_IDEAS
  EVALUATING_CONCEPTS
  WRITING_STORY
  GENERATING_SCENES
  GENERATING_ILLUSTRATIONS
  GENERATING_VOICEOVER
  SYNCHRONIZING_NARRATION
  RENDERING_VIDEO
  UPLOADING_MP4
  COMPLETED
  FAILED
  CANCELED
}

enum Provider {
  OPENAI_TEXT
  OPENAI_IMAGE
  ELEVENLABS
  VERCEL_SANDBOX
}

enum ProposalStatus {
  PENDING
  APPLIED
  REJECTED
  SUPERSEDED
}

enum AudioAssetKind {
  MUSIC
  SFX
}

enum NarrationPerspective {
  FIRST_PERSON
  THIRD_PERSON
}

// ───────────────────────────── Characters ──────────────────────────

/// A recurring narrator/hero that series are built around.
model Character {
  id                String               @id @default(cuid())
  name              String
  tagline           String
  /// The producer's original one-line description.
  brief             String
  personality       String
  backstory         String
  /// How the character talks when narrating.
  speakingStyle     String
  /// How to draw them: stick-figure build, clothing, props, signature colour item.
  visualDescription String
  /// Hex colour of the character's clothing accent (their signature item).
  signatureColor    String               @default("#E0362C")
  /// Video band colour; null derives a muted version of signatureColor.
  bandColor         String?
  perspective       NarrationPerspective @default(FIRST_PERSON)
  voiceId           String?
  /// Character reference sheet, passed to every scene illustration.
  sheetUrl          String?
  archivedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  stories Story[]
  batches Batch[]
  costs   CostEntry[]
}

// ───────────────────────────── Stories ─────────────────────────────

model Story {
  id                   String      @id @default(cuid())
  title                String
  normalizedTitle      String
  category             String
  premise              String
  logline              String?
  keywords             String[]
  status               StoryStatus @default(CONCEPT)
  factMode             FactMode    @default(MIXED)
  styleKey             String      @default("stick-figure")
  voiceId              String?
  targetDurationSec    Int         @default(75)
  quality              Quality     @default(STANDARD)
  thumbnailUrl         String?
  /// "bands": 3:2 landscape art between coloured title/caption bands. "full": legacy full-frame portrait art.
  videoFormat          String      @default("bands")
  characterId          String?
  character            Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)
  hasUnresolvedThreads Boolean     @default(true)
  archivedAt           DateTime?
  lastActivityAt       DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  conceptId String?  @unique
  concept   Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  bibles           StoryBible[]
  episodes         Episode[]
  proposals        BibleUpdateProposal[]
  visualReferences VisualReference[]
  claims           FactClaim[]
  jobs             Job[]
  costs            CostEntry[]

  @@index([status])
  @@index([normalizedTitle])
  @@index([lastActivityAt])
}

/// Versioned story bible. `data` is validated by StoryBibleSchema (src/lib/schemas/story-bible.ts).
model StoryBible {
  id              String   @id @default(cuid())
  storyId         String
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  version         Int
  data            Json
  /// Where this version came from: "concept", "episode-approval", "manual-edit".
  source          String
  sourceEpisodeId String?
  note            String?
  createdAt       DateTime @default(now())

  @@unique([storyId, version])
}

/// Continuity changes proposed by an unapproved episode. Applied only when the episode is approved.
model BibleUpdateProposal {
  id               String         @id @default(cuid())
  storyId          String
  story            Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  episodeVersionId String         @unique
  episodeVersion   EpisodeVersion @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  baseBibleVersion Int
  /// StoryBibleUpdateSchema payload.
  update           Json
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  resolvedAt       DateTime?
}

model VisualReference {
  id          String   @id @default(cuid())
  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name        String
  /// "character" | "object" | "location" | "style"
  kind        String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@unique([storyId, name])
}

// ───────────────────────────── Episodes ─────────────────────────────

model Episode {
  id                String          @id @default(cuid())
  storyId           String
  story             Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  partNumber        Int
  title             String
  status            EpisodeStatus   @default(DRAFT)
  currentVersionId  String?         @unique
  currentVersion    EpisodeVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  publishedAt       DateTime?
  publishedUrl      String?
  publishedPlatform String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  versions EpisodeVersion[]    @relation("EpisodeVersions")
  hooks    Hook[]
  metrics  PerformanceMetric[]
  jobs     Job[]
  costs    CostEntry[]

  @@unique([storyId, partNumber])
}

/// An immutable-once-approved script version with its scenes and generated media.
model EpisodeVersion {
  id                   String          @id @default(cuid())
  episodeId            String
  episode              Episode         @relation("EpisodeVersions", fields: [episodeId], references: [id], onDelete: Cascade)
  currentOf            Episode?        @relation("CurrentVersion")
  version              Int
  status               VersionStatus   @default(DRAFT)
  parentVersionId      String?
  /// Why this version exists: "initial", "regenerate-script", "regenerate-hook", "edit-scene", "fork-locked".
  reason               String
  /// EpisodeSpecSchema payload as written (excluding scenes, which are rows).
  spec                 Json
  narration            String
  wordCount            Int
  estimatedDurationSec Float
  summary              String
  factCheckStatus      FactCheckStatus @default(PENDING)
  factReview           Json?
  continuityReview     Json?
  /// Global style + per-story visual notes used to build image prompts.
  styleKey             String
  voiceoverId          String?
  voiceover            Voiceover?      @relation("CurrentVoiceover", fields: [voiceoverId], references: [id], onDelete: SetNull)
  /// Scene timing derived from the current voiceover alignment; null when stale.
  timing               Json?
  createdAt            DateTime        @default(now())

  scenes     Scene[]
  voiceovers Voiceover[]          @relation("VersionVoiceovers")
  renders    Render[]
  claims     FactClaim[]
  proposal   BibleUpdateProposal?

  @@unique([episodeId, version])
}

model Hook {
  id         String   @id @default(cuid())
  episodeId  String
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type       HookType
  text       String
  scores     Json
  totalScore Float
  rationale  String
  isPrimary  Boolean  @default(false)
  /// Generation round, so regenerated hooks don't erase earlier alternatives.
  round      Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([episodeId])
}

model Scene {
  id                  String         @id @default(cuid())
  episodeVersionId    String
  episodeVersion      EpisodeVersion @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  sceneNumber         Int
  narration           String
  imagePrompt         String
  composition         String
  /// What must stay true in this shot (where the hero is, time of day, what changed).
  continuity          String         @default("")
  characters          String[]
  objects             String[]
  intendedDurationSec Float
  motionPreset        String
  currentImageId      String?
  currentImage        SceneImage?    @relation("CurrentImage", fields: [currentImageId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())

  images SceneImage[] @relation("SceneImages")

  @@unique([episodeVersionId, sceneNumber])
}

/// Image history for a scene. When a version is forked, unchanged scenes point at the
/// same image row through `currentImageId`, so `sceneId` is the scene that first produced it.
model SceneImage {
  id            String      @id @default(cuid())
  sceneId       String
  scene         Scene       @relation("SceneImages", fields: [sceneId], references: [id], onDelete: Cascade)
  currentOf     Scene[]     @relation("CurrentImage")
  version       Int
  status        AssetStatus @default(PENDING)
  url           String?
  blobPath      String?
  prompt        String
  model         String
  quality       String
  usedReference Boolean     @default(false)
  review        Json?
  error         String?
  costUsd       Decimal     @default(0) @db.Decimal(12, 6)
  createdAt     DateTime    @default(now())

  @@index([sceneId])
}

model Voiceover {
  id               String           @id @default(cuid())
  episodeVersionId String
  episodeVersion   EpisodeVersion   @relation("VersionVoiceovers", fields: [episodeVersionId], references: [id], onDelete: Cascade)
  currentOf        EpisodeVersion[] @relation("CurrentVoiceover")
  version          Int
  status           AssetStatus      @default(PENDING)
  voiceId          String
  modelId          String
  settings         Json
  text             String
  url              String?
  blobPath         String?
  durationMs       Int?
  /// Raw character-level alignment from ElevenLabs.
  alignment        Json?
  /// Word timings derived from alignment: [{ text, startMs, endMs }].
  words            Json?
  characterCount   Int              @default(0)
  error            String?
  costUsd          Decimal          @default(0) @db.Decimal(12, 6)
  createdAt        DateTime         @default(now())
}

model Render {
  id               String         @id @default(cuid())
  episodeVersionId String
  episodeVersion   EpisodeVersion @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  version          Int
  status           AssetStatus    @default(PENDING)
  /// Snapshot of what was rendered: voiceover id + scene image ids.
  inputs           Json
  inputProps       Json
  url              String?
  sizeBytes        Int?
  durationSec      Float?
  sandboxId        String?
  commandId        String?
  progress         Float          @default(0)
  error            String?
  costUsd          Decimal        @default(0) @db.Decimal(12, 6)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([episodeVersionId])
}

model FactClaim {
  id               String              @id @default(cuid())
  storyId          String
  story            Story               @relation(fields: [storyId], references: [id], onDelete: Cascade)
  episodeVersionId String
  episodeVersion   EpisodeVersion      @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  claim            String
  classification   ClaimClassification
  status           ClaimStatus         @default(UNVERIFIED)
  reasoning        String
  references       String[]
  resolutionNote   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([episodeVersionId])
}

model PerformanceMetric {
  id              String   @id @default(cuid())
  episodeId       String
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  platform        String
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  followersGained Int?
  avgWatchTimeSec Float?
  completionRate  Float?
  notes           String?
  recordedAt      DateTime @default(now())
}

// ───────────────────────────── Batches & concepts ─────────────────────────────

model Batch {
  id                String     @id @default(cuid())
  mode              BatchMode
  category          String
  customDirection   String?
  requestedCount    Int
  targetDurationSec Int
  styleKey          String
  voiceId           String
  quality           Quality
  maxBudgetUsd      Decimal    @db.Decimal(12, 6)
  autoSelect        Boolean    @default(false)
  estimatedCostUsd  Decimal    @default(0) @db.Decimal(12, 6)
  characterId       String?
  character         Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())

  concepts Concept[]
  jobs     Job[]
}

model Concept {
  id               String        @id @default(cuid())
  batchId          String
  batch            Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title            String
  normalizedTitle  String
  premise          String
  logline          String
  category         String
  keywords         String[]
  factMode         FactMode @default(MIXED)
  seriesPotential  String
  scores           Json?
  totalScore       Float?
  rank             Int?
  status           ConceptStatus @default(CANDIDATE)
  duplicateOfTitle String?
  similarity       Float?
  createdAt        DateTime      @default(now())

  story Story?

  @@index([batchId])
}

// ───────────────────────────── Jobs & costs ─────────────────────────────

model Job {
  id           String    @id @default(cuid())
  type         JobType
  status       JobStatus @default(QUEUED)
  stage        String?
  progress     Float     @default(0)
  input        Json
  output       Json?
  error        Json?
  triggerRunId String?
  attempts     Int       @default(0)
  batchId      String?
  batch        Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  storyId      String?
  story        Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  episodeId    String?
  episode      Episode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  costs CostEntry[]

  @@index([status])
  @@index([createdAt])
}

model CostEntry {
  id          String     @id @default(cuid())
  provider    Provider
  model       String
  operation   String
  /// Provider usage units (tokens, characters, seconds, images).
  usage       Json
  costUsd     Decimal    @db.Decimal(12, 6)
  /// True when cost was computed from configured pricing rather than reported by the provider.
  estimated   Boolean    @default(true)
  jobId       String?
  job         Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  storyId     String?
  story       Story?     @relation(fields: [storyId], references: [id], onDelete: SetNull)
  episodeId   String?
  episode     Episode?   @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  batchId     String?
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([batchId])
  @@index([storyId])
  @@index([createdAt])
}

// ───────────────────────────── Settings & assets ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Bundled/licensed audio. Only owned, public-domain, or properly licensed assets belong here.
model AudioAsset {
  id          String         @id @default(cuid())
  name        String
  kind        AudioAssetKind
  url         String
  license     String
  source      String
  attribution String?
  createdAt   DateTime       @default(now())
}
