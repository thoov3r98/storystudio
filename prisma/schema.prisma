// The Invisible World Studio — data model.
//
// Conventions:
// - Every generated artifact (script version, scene image, voiceover, render) is
//   an immutable row. "Current" pointers select which row is live, so history is
//   never overwritten.
// - Money is stored as Decimal(12, 6) USD.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum StoryStatus {
  CONCEPT
  IN_PRODUCTION
  READY
  PUBLISHED
  CONTINUING
  ARCHIVED
}

enum EpisodeStatus {
  DRAFT // script not storyboarded yet
  SCRIPTED // storyboarded, not yet produced
  IN_PRODUCTION
  READY // MP4 rendered, awaiting approval
  APPROVED // locked: changes fork a new version
  PUBLISHED // manually published by the user
  FAILED
}

enum VersionStatus {
  DRAFT
  APPROVED // locked: edits fork a new version
  SUPERSEDED
}

enum AssetStatus {
  PENDING
  GENERATING
  SUCCEEDED
  FAILED
}

enum Quality {
  DRAFT
  STANDARD
  PREMIUM
}

enum JobType {
  /// Splits a pasted script into parts and storyboards each one.
  STORYBOARD
  EPISODE_PRODUCTION
  REGENERATE_IMAGE
  REGENERATE_VOICEOVER
  RENDER
}

enum JobStatus {
  QUEUED
  STORYBOARDING
  GENERATING_SCENES
  GENERATING_ILLUSTRATIONS
  GENERATING_VOICEOVER
  SYNCHRONIZING_NARRATION
  RENDERING_VIDEO
  UPLOADING_MP4
  COMPLETED
  FAILED
  CANCELED
}

enum Provider {
  OPENAI_TEXT
  OPENAI_IMAGE
  ELEVENLABS
  VERCEL_SANDBOX
}

enum AudioAssetKind {
  MUSIC
  SFX
}

/// Picks a channel's base storyboard rules, sound effects, music bed and post text. Every new channel is CUSTOM; the other two are the presets older channels were made with.
enum ChannelFormat {
  PROCESS_EXPLAINER // How It's Made: a factory process
  INVISIBLE_EXPLAINER // "What happens when…": the hidden journey behind an everyday moment
  CUSTOM // No preset: a neutral base, steered by the channel's own description
}

// ───────────────────────────── Channels ────────────────────────────

/// A TikTok channel: the voice, illustration style, quality and storyboard rules every pasted script is made with.
model Channel {
  id         String        @id @default(cuid())
  name       String
  format     ChannelFormat
  /// { visuals }: how the storyboard shows this channel's videos.
  profile    Json
  voiceId    String?
  styleKey   String        @default("stick-figure-color")
  quality    Quality       @default(STANDARD)
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  stories Story[]
}

// ───────────────────────────── Stories ─────────────────────────────

model Story {
  id                String      @id @default(cuid())
  title             String
  normalizedTitle   String
  /// The producer's script exactly as pasted. Null on stories written before November 2026.
  sourceScript      String?
  /// The producer's notes for the storyboard ("keep it at night", "show machines, not people").
  visualNotes       String?
  status            StoryStatus @default(CONCEPT)
  styleKey          String      @default("stick-figure")
  voiceId           String?
  /// Expected length of each video, from the script's word count and the voice's pace.
  targetDurationSec Int         @default(75)
  /// How many videos the script is split into.
  plannedParts      Int         @default(1)
  quality           Quality     @default(STANDARD)
  thumbnailUrl      String?
  channelId         String?
  channel           Channel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  lastActivityAt    DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  episodes Episode[]
  jobs     Job[]
  costs    CostEntry[]

  @@index([status])
  @@index([normalizedTitle])
  @@index([lastActivityAt])
  @@index([channelId])
}

// ───────────────────────────── Episodes ─────────────────────────────

model Episode {
  id                String          @id @default(cuid())
  storyId           String
  story             Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  partNumber        Int
  title             String
  /// This part's slice of the pasted script, word for word, before it is storyboarded.
  script            String?
  status            EpisodeStatus   @default(DRAFT)
  currentVersionId  String?         @unique
  currentVersion    EpisodeVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  publishedAt       DateTime?
  publishedUrl      String?
  publishedPlatform String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  versions EpisodeVersion[]    @relation("EpisodeVersions")
  metrics  PerformanceMetric[]
  jobs     Job[]
  costs    CostEntry[]

  @@unique([storyId, partNumber])
}

/// An immutable-once-approved script version with its scenes and generated media.
model EpisodeVersion {
  id                   String        @id @default(cuid())
  episodeId            String
  episode              Episode       @relation("EpisodeVersions", fields: [episodeId], references: [id], onDelete: Cascade)
  currentOf            Episode?      @relation("CurrentVersion")
  version              Int
  status               VersionStatus @default(DRAFT)
  parentVersionId      String?
  /// Why this version exists: "pasted", "edit-scene", "edit-hook", "fork-locked", "restore-vN".
  reason               String
  /// EpisodeSpecSchema payload as written (excluding scenes, which are rows).
  spec                 Json
  narration            String
  wordCount            Int
  estimatedDurationSec Float
  summary              String
  /// Global style + per-story visual notes used to build image prompts.
  styleKey             String
  /// Illustration shape: "square" (1024×1024, square layout) or "landscape" (1536×1024, bands layout, before November 2026).
  imageShape           String        @default("square")
  /// Caption, hashtags, cover and pinned comment for posting; written after the video renders.
  postCopy             Json?
  voiceoverId          String?
  voiceover            Voiceover?    @relation("CurrentVoiceover", fields: [voiceoverId], references: [id], onDelete: SetNull)
  /// Scene timing derived from the current voiceover alignment; null when stale.
  timing               Json?
  createdAt            DateTime      @default(now())

  scenes     Scene[]
  voiceovers Voiceover[] @relation("VersionVoiceovers")
  renders    Render[]

  @@unique([episodeId, version])
}

model Scene {
  id                  String         @id @default(cuid())
  episodeVersionId    String
  episodeVersion      EpisodeVersion @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  sceneNumber         Int
  narration           String
  imagePrompt         String
  composition         String
  /// What must stay true in this shot (where the hero is, time of day, what changed).
  continuity          String         @default("")
  characters          String[]
  objects             String[]
  intendedDurationSec Float
  motionPreset        String
  /// A key of SOUND_EFFECTS (src/lib/constants.ts), or "none".
  soundEffect         String         @default("none")
  /// The manufacturing step on screen while this shot plays (2–4 words); consecutive shots of one step share it.
  stepLabel           String         @default("")
  currentImageId      String?
  currentImage        SceneImage?    @relation("CurrentImage", fields: [currentImageId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())

  images SceneImage[] @relation("SceneImages")

  @@unique([episodeVersionId, sceneNumber])
}

/// Image history for a scene. When a version is forked, unchanged scenes point at the
/// same image row through `currentImageId`, so `sceneId` is the scene that first produced it.
model SceneImage {
  id            String      @id @default(cuid())
  sceneId       String
  scene         Scene       @relation("SceneImages", fields: [sceneId], references: [id], onDelete: Cascade)
  currentOf     Scene[]     @relation("CurrentImage")
  version       Int
  status        AssetStatus @default(PENDING)
  url           String?
  blobPath      String?
  prompt        String
  model         String
  quality       String
  usedReference Boolean     @default(false)
  review        Json?
  error         String?
  costUsd       Decimal     @default(0) @db.Decimal(12, 6)
  createdAt     DateTime    @default(now())

  @@index([sceneId])
}

model Voiceover {
  id               String           @id @default(cuid())
  episodeVersionId String
  episodeVersion   EpisodeVersion   @relation("VersionVoiceovers", fields: [episodeVersionId], references: [id], onDelete: Cascade)
  currentOf        EpisodeVersion[] @relation("CurrentVoiceover")
  version          Int
  status           AssetStatus      @default(PENDING)
  voiceId          String
  modelId          String
  settings         Json
  text             String
  url              String?
  blobPath         String?
  durationMs       Int?
  /// Raw character-level alignment from ElevenLabs.
  alignment        Json?
  /// Word timings derived from alignment: [{ text, startMs, endMs }].
  words            Json?
  characterCount   Int              @default(0)
  error            String?
  costUsd          Decimal          @default(0) @db.Decimal(12, 6)
  createdAt        DateTime         @default(now())
}

model Render {
  id               String         @id @default(cuid())
  episodeVersionId String
  episodeVersion   EpisodeVersion @relation(fields: [episodeVersionId], references: [id], onDelete: Cascade)
  version          Int
  status           AssetStatus    @default(PENDING)
  /// Snapshot of what was rendered: voiceover id + scene image ids.
  inputs           Json
  inputProps       Json
  url              String?
  sizeBytes        Int?
  durationSec      Float?
  sandboxId        String?
  commandId        String?
  progress         Float          @default(0)
  error            String?
  costUsd          Decimal        @default(0) @db.Decimal(12, 6)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([episodeVersionId])
}

model PerformanceMetric {
  id              String   @id @default(cuid())
  episodeId       String
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  platform        String
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  followersGained Int?
  avgWatchTimeSec Float?
  /// % of viewers still watching after the first few seconds.
  earlyRetention  Float?
  completionRate  Float?
  /// Rewatches as a % of views.
  rewatchRate     Float?
  notes           String?
  recordedAt      DateTime @default(now())
}

// ───────────────────────────── Jobs & costs ─────────────────────────────

model Job {
  id           String    @id @default(cuid())
  type         JobType
  status       JobStatus @default(QUEUED)
  stage        String?
  progress     Float     @default(0)
  input        Json
  output       Json?
  error        Json?
  triggerRunId String?
  attempts     Int       @default(0)
  storyId      String?
  story        Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  episodeId    String?
  episode      Episode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  costs CostEntry[]

  @@index([status])
  @@index([createdAt])
}

model CostEntry {
  id        String   @id @default(cuid())
  provider  Provider
  model     String
  operation String
  /// Provider usage units (tokens, characters, seconds, images).
  usage     Json
  costUsd   Decimal  @db.Decimal(12, 6)
  /// True when cost was computed from configured pricing rather than reported by the provider.
  estimated Boolean  @default(true)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  storyId   String?
  story     Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([createdAt])
}

// ───────────────────────────── Settings & assets ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Bundled/licensed audio. Only owned, public-domain, or properly licensed assets belong here.
model AudioAsset {
  id          String         @id @default(cuid())
  /// Set on assets the studio generates itself ("music:default", "sfx:press"), so each is made once and reused.
  key         String?        @unique
  name        String
  kind        AudioAssetKind
  url         String
  license     String
  source      String
  attribution String?
  createdAt   DateTime       @default(now())
}
