{
  "name": "invisible-world-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && remotion bundle src/remotion/index.ts --out-dir=remotion-bundle && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:bundle": "remotion bundle src/remotion/index.ts --out-dir=remotion-bundle",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@remotion/bundler": "4.0.539",
    "@remotion/captions": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/vercel": "4.0.539",
    "@trigger.dev/sdk": "^4.8.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^1.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^7.45.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@remotion/cli": "4.0.539",
    "@tailwindcss/turbopack": "^4",
    "@trigger.dev/build": "^4.8.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "trigger.dev": "4.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.5.1"
}
